{
    "manifest_version": 3,
    "name": "NeuroRead",
    "version": "1.0",
    "description": "Brain-friendly reading for ADHD and Dyslexic minds",
    "permissions": [
      "activeTab",
      "scripting",
      "storage"
    ],
    "host_permissions": [
      "https://neuroread.khaldosh.dev/*",
      "https://*/*",
      "http://*/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_title": "NeuroRead",
      "default_icon": "favicon.png"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "css": ["injected.css", "content.css"],
        "js": ["content.js"]
      }
    ]
  }