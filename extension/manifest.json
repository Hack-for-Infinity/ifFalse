{
    "manifest_version": 3,
    "name": "NeuroRead",
    "version": "1.0",
    "description": "Brain-friendly reading for ADHD and Dyslexic minds",
    "permissions": [
      "activeTab",
      "scripting",
      "storage"
    ],
    "action": {
      "default_popup": "popup.html",
      "default_title": "NeuroRead"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "css": ["injected.css"],
        "js": ["content.js"]
      }
    ]
  }